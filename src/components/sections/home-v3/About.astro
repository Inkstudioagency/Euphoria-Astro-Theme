---
import VideoLightboxData from '../../ui/VideoLightboxData.astro';
---
<section class="section_about section-gap">
  <div class="container-main">
    <div class="about-layout">
      <div reveal-anim-1="" class="about-header">
        <div class="section-eyebrow is-white">
          <div class="section-eyebrow-dot"></div>
          <div>About us</div>
        </div>
        <h2 text-color-reveal="" class="heading-style-4 about-title">Revitalizing Your Workspace With Innovative SaaS Solutions. Providing Reliable, Precise, And Secure Technology Services That Enhance Productivity And Trust.</h2>
        <div class="about-social">
          <div class="avatar-stack"><img src="/images/about-avatar-1.webp" loading="lazy" alt="Team member portrait" class="avatar-stack-item"><img src="/images/about-avatar-2.webp" loading="lazy" alt="Team member portrait" class="avatar-stack-item"><img src="/images/about-avatar-3-1x_1about-avatar-3-1x.webp" loading="lazy" alt="Team member portrait" class="avatar-stack-item">
            <div class="avatar-stack-count">120k</div>
          </div>
          <p class="text-size-regular text-color-primary">Background-checked and verified finance experts.</p>
        </div>
      </div>
      <div class="about-body">
        <div reveal-anim-3="" class="about-aside">
          <a href="/about-v3" class="primary-button w-inline-block">
            <div class="button-text">Learn About Us</div>
            <div class="button-icon-wrapper">
              <div class="button-icon w-embed"><svg width="100%" height="100%" viewbox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M1.24996 8.12535L1.24988 6.87543H11.3573L8.88879 4.40682L9.77266 3.52295L13.7501 7.50045L9.77266 11.4779L8.88879 10.594L11.3574 8.12542L1.24996 8.12535Z" fill="currentColor"></path>
                </svg></div>
            </div>
          </a>
          <a href="#" class="about-video w-inline-block w-lightbox"><img src="/images/about-video-thumbnail-1x_1about-video-thumbnail-1x.webp" loading="lazy" alt="Team collaborating in a warm-lit office" class="cover-image">
            <div class="video-badge"><img src="/images/icon-play.svg" loading="lazy" alt="icon-play" class="video-badge-icon">
              <div>Watch</div>
            </div>
            <VideoLightboxData />
          </a>
        </div>
        <div class="stats-grid">
          <div card-hover="" reveal-anim-2="" class="stat-card is-dark">
            <div class="stat-card-top">
              <div class="stat-card-label">Projects Completed</div><img src="/images/about-stat-photo.webp" loading="lazy" alt="Smiling accountant working on a laptop" class="stat-card-image">
            </div>
            <div class="stat-card-bottom">
              <div data-counter="counter" class="stat-card-value">3.5x</div>
              <p class="stat-card-text">Faster month-end close, allowing teams to focus on high-value work instead of manual processes.</p>
            </div>
          </div>
          <div card-hover="" reveal-anim-3="" class="stat-card">
            <div class="stat-card-top">
              <div class="stat-card-label">Automated Actions Run Daily</div><img src="/images/feature-consulting-photo.webp" loading="lazy" sizes="(max-width: 1100px) 100vw, 1100px" srcset="/images/feature-consulting-photo-p-500.webp 500w, /images/feature-consulting-photo-p-800.webp 800w, /images/feature-consulting-photo-p-1080.webp 1080w, /images/feature-consulting-photo.webp 1100w" alt="Consultant reviewing automated finance workflows on a laptop" class="stat-card-image is-collapsed">
            </div>
            <div class="stat-card-bottom">
              <div data-counter="counter" class="stat-card-value">410k</div>
              <p class="stat-card-text is-collapsed">Recurring entries, bank matches and approvals run on their own, every single day, with a full audit trail.</p>
            </div>
          </div>
          <div card-hover="" reveal-anim-4="" class="stat-card">
            <div class="stat-card-top">
              <div class="stat-card-label">Transactions Reconciled</div><img src="/images/testimonial-case-1_1testimonial-case-1.webp" loading="lazy" sizes="(max-width: 640px) 100vw, 640px" srcset="/images/testimonial-case-1_1-p-500.webp 500w, /images/testimonial-case-1_1testimonial-case-1.webp 640w" alt="Finance lead reviewing reconciled accounts on a laptop" class="stat-card-image is-collapsed">
            </div>
            <div class="stat-card-bottom">
              <div data-counter="counter" class="stat-card-value">$120m+</div>
              <p class="stat-card-text is-collapsed">Matched automatically across every account, entity and currency, so the books close without spreadsheets.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
