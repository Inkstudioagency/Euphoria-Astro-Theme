---
import { getCaseStudies } from '../../../lib/cms';
import CaseCardSlider from '../../cms/CaseCardSlider.astro';

const list1 = await getCaseStudies();
---
<section class="section_testimonials section-gap">
  <div class="container-main">
    <div class="section-stack">
      <div class="section-header is-centered">
        <div reveal-anim-1="" class="section-eyebrow is-white">
          <div class="section-eyebrow-dot"></div>
          <div>Testimonial</div>
        </div>
        <h2 section-title="" class="heading-style-2 section-title is-centered">See Why Customers Love Using Euphoria</h2>
      </div>
      <CaseCardSlider items={list1} />
      <div reveal-anim-2="" class="case-footer-row is-tight">
        <div class="case-rating">
          <div class="case-rating-value">4.8</div>
          <div class="text-size-small text-color-secondary">From 3k members,<br>reviewed by Google</div>
        </div>
        <div class="slider-arrows">
          <a href="#" class="slider-arrow w-inline-block">
            <div class="slider-arrow-icon is-flipped w-embed"><svg width="100%" height="100%" viewbox="0 0 29 29" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M10.8 21.6C10.8 21.6 18 16.297 18 14.4C18 12.502 10.8 7.2 10.8 7.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg></div>
          </a>
          <a href="#" class="slider-arrow w-inline-block">
            <div class="slider-arrow-icon w-embed"><svg width="100%" height="100%" viewbox="0 0 29 29" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M10.8 21.6C10.8 21.6 18 16.297 18 14.4C18 12.502 10.8 7.2 10.8 7.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg></div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
