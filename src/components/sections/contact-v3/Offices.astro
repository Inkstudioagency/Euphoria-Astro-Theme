<section class="section_offices">
  <div class="container-main section-gap">
    <div class="section-header-row is-spaced">
      <div class="section-header">
        <div reveal-anim-1="" class="section-eyebrow is-white">
          <div class="section-eyebrow-dot"></div>
          <div>Offices</div>
        </div>
        <h2 section-title="" class="heading-style-2 section-title is-wide">Our Continental Offices</h2>
      </div>
    </div>
    <div class="office-grid">
      <div reveal-anim-3="" card-hover="" class="office-card"><img class="office-card-image" src="/images/office-melbourne.webp" alt="Melbourne office" card-hover-image="" sizes="100vw" loading="lazy" srcset="/images/office-melbourne-p-500.webp 500w, /images/office-melbourne-p-800.webp 800w, /images/office-melbourne-p-1080.webp 1080w, /images/office-melbourne.webp 1260w">
        <div class="office-card-overlay"></div>
        <div class="office-card-content">
          <h3 class="heading-style-4 text-color-inverse">Melbourne, Australia</h3>
          <div class="office-card-footer">
            <div class="office-card-lines">
              <div class="office-card-line"><img src="/images/icon-phone-white.svg" loading="lazy" alt="icon-phone-white" class="office-card-icon">
                <div>+1 (555) 555-0124</div>
              </div>
              <div class="office-card-line"><img src="/images/icon-mail-white.svg" loading="lazy" alt="icon-mail-white" class="office-card-icon">
                <div>hi@example.com</div>
              </div>
            </div>
            <a href="https://maps.google.com" target="_blank" class="pill-button is-white">Get Directions</a>
          </div>
        </div>
      </div>
      <div reveal-anim-4="" card-hover="" class="office-card"><img class="office-card-image" src="/images/office-germany.webp" alt="Germany office" card-hover-image="" sizes="100vw" loading="lazy" srcset="/images/office-germany-p-500.webp 500w, /images/office-germany-p-800.webp 800w, /images/office-germany-p-1080.webp 1080w, /images/office-germany.webp 1260w">
        <div class="office-card-overlay"></div>
        <div class="office-card-content">
          <h3 class="heading-style-4 text-color-inverse">Berlin, Germany</h3>
          <div class="office-card-footer">
            <div class="office-card-lines">
              <div class="office-card-line"><img src="/images/icon-phone-white.svg" loading="lazy" alt="icon-phone-white" class="office-card-icon">
                <div>+1 (555) 555-0123</div>
              </div>
              <div class="office-card-line"><img src="/images/icon-mail-white.svg" loading="lazy" alt="icon-mail-white" class="office-card-icon">
                <div>berlin@example.com</div>
              </div>
            </div>
            <a href="https://maps.google.com" target="_blank" class="pill-button is-white">Get Directions</a>
          </div>
        </div>
      </div>
    </div>
  </div>
