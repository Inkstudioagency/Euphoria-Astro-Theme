---
import { getFeaturedPosts } from '../../../lib/cms';
import BlogCardList from '../../cms/BlogCardList.astro';

const list1 = await getFeaturedPosts(4);
---
<section class="section_blog section-gap">
  <div class="container-main">
    <div class="blog-layout">
      <div class="section-header-row">
        <div class="section-header max-width-25">
          <div reveal-anim-1="" class="section-eyebrow is-white">
            <div class="section-eyebrow-dot"></div>
            <div>Blogs</div>
          </div>
          <h2 section-title="" class="heading-style-2 section-title">Stay Up to Date with Our Journal</h2>
        </div>
        <div reveal-anim-3="" class="button-wrapper">
          <a href="/blog" class="primary-button w-inline-block">
            <div class="button-text">View All Blogs</div>
            <div class="button-icon-wrapper">
              <div class="button-icon w-embed"><svg width="100%" height="100%" viewbox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M1.24996 8.12535L1.24988 6.87543H11.3573L8.88879 4.40682L9.77266 3.52295L13.7501 7.50045L9.77266 11.4779L8.88879 10.594L11.3574 8.12542L1.24996 8.12535Z" fill="currentColor"></path>
                </svg></div>
            </div>
          </a>
        </div>
      </div>
      <div>
        <BlogCardList posts={list1} variant="horizontal" />
      </div>
    </div>
  </div>
</section>
