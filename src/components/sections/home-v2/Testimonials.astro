---
import { getCaseStudies } from '../../../lib/cms';
import CaseCardSlider from '../../cms/CaseCardSlider.astro';

const list1 = await getCaseStudies();
---
<section class="section_testimonials section-gap">
  <div class="container-main">
    <div class="section-stack">
      <div class="section-header is-centered">
        <div reveal-anim-1="" class="section-eyebrow is-white">
          <div class="section-eyebrow-dot"></div>
          <div>Testimonial</div>
        </div>
        <h2 section-title="" class="heading-style-2 section-title is-centered is-narrow">See Why Customers Love Using</h2>
      </div>
      <CaseCardSlider items={list1} />
      <div reveal-anim-2="" class="case-footer-row is-tight">
        <div class="case-rating">
          <div class="case-rating-value is-large">4.8</div>
          <div class="case-rating-text">From 3k members,<br>reviewed by Google</div>
        </div>
        <div class="slider-arrows">
          <a aria-label="Previous case study" href="#" class="slider-arrow w-inline-block">
            <div class="slider-arrow-icon w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M15 6C15 6 9 10.4189 9 12C9 13.5812 15 18 15 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg></div>
          </a>
          <a aria-label="Next case study" href="#" class="slider-arrow w-inline-block">
            <div class="slider-arrow-icon w-embed"><svg width="100%" height="100%" viewbox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M9 6C9 6 15 10.4189 15 12C15 13.5812 9 18 9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg></div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
