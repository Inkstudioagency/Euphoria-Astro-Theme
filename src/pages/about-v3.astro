---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/about-v3/PageHero.astro';
import About from '../components/sections/about-v3/About.astro';
import Timeline from '../components/sections/about-v3/Timeline.astro';
import Team from '../components/sections/about-v3/Team.astro';
import VideoTestimonial from '../components/sections/shared/VideoTestimonial.astro';
import Testimonials from '../components/sections/about-v3/Testimonials.astro';
import Marquee from '../components/sections/shared/Marquee.astro';
import FaqV3 from '../components/sections/shared/FaqV3.astro';
import Blog from '../components/sections/about-v3/Blog.astro';
import Cta from '../components/sections/about-v3/Cta.astro';
---
<BaseLayout
  title="About | Euphoria"
  description="Meet the team behind Euphoria, the finance automation platform helping growing companies close faster, stay compliant and report to investors with confidence."
>
  <main class="main-wrapper">
    <PageHero />
    <About />
    <Timeline />
    <Team />
    <VideoTestimonial />
    <Testimonials />
    <Marquee />
    <FaqV3 />
    <Blog />
    <Cta />
  </main>
</BaseLayout>
