# Strapi CMS (see THEME-CUSTOMIZATION.md → CMS). Leave empty to build from the bundled demo content.
STRAPI_URL=http://localhost:1337
# Optional read-only API token (Strapi → Settings → API Tokens → Read-only).
# Leave empty if the Public role can read the collections (npm run seed sets that up).
STRAPI_API_TOKEN=

# Public URL of the deployed site, used for canonical URLs, Open Graph and the sitemap.
SITE_URL=https://example.com

# Form endpoint (Formspree, Web3Forms, Basin, …). Empty = demo mode (forms show success, nothing is sent).
PUBLIC_FORM_ENDPOINT=
