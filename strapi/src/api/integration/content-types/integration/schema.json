      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "mainImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "excerpt": {
      "type": "text"
    },
    "body": {
      "type": "richtext"
    },
    "category": {
      "type": "string"
    },
    "filterCategory": {
      "type": "string"
    },
    "website": {
      "type": "string"
    }
  }
}
