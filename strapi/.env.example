# Server
HOST=0.0.0.0
PORT=1337

# Secrets — `npm run setup` creates .env with random values for these.
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (SQLite for local development; use Postgres in production)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Strapi MCP server at /mcp (set to false to turn it off)
STRAPI_MCP_ENABLED=true
